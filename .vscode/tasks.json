{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "traceflow: trace current file",
      "type": "shell",
      "command": "python",
      "args": ["-m", "traceflow", "run", "-o", "traces", "--sqlite", "${file}"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "traceflow: live (pause, step, intercept) current file",
      "type": "shell",
      "command": "python",
      "args": ["-m", "traceflow", "run", "-o", "traces", "--live", "--pause-at-start", "${file}"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "traceflow: security scan current file",
      "type": "shell",
      "command": "python",
      "args": ["-m", "traceflow", "run", "-o", "traces", "--sqlite", "--security", "${file}"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "traceflow: trace JS/TS current file",
      "type": "shell",
      "command": "python",
      "args": ["-m", "traceflow", "run", "-o", "traces", "--sqlite", "${file}"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "traceflow: security scan JS/TS current file",
      "type": "shell",
      "command": "python",
      "args": ["-m", "traceflow", "run", "-o", "traces", "--sqlite", "--security", "${file}"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "traceflow: trace module (python -m)",
      "type": "shell",
      "command": "python",
      "args": ["-m", "traceflow", "run", "-o", "traces", "--sqlite", "-m", "${input:module}"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "focus": true, "panel": "dedicated" },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "module",
      "type": "promptString",
      "description": "Module to run, as you'd pass to `python -m` (e.g. myapp or myapp.cli)"
    }
  ]
}
